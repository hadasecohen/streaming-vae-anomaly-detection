__pycache__/
*.pyc
.ipynb_checkpoints/

runs/
scratchpad/

# Full-scale real ERA5 source (~550MB total, not included in this repo — see
# DATA_LICENSE.md). Local-only copy for full-scale experiments (e.g. case01's
# full-scale override in case01_clean_baseline_suite.yaml).
data/era5/full_scale/*
# Exception: the clean (no injected anomalies) full-scale data, pre-split
# into warmup/test files each under GitHub's 100MB limit — these ARE shipped.
# (Must ignore the directory's *contents* with /* rather than the directory
# itself with a trailing / — git won't apply a negation to a file inside a
# directory that's ignored as a whole.)
!data/era5/full_scale/era5_clean_warmup.csv
!data/era5/full_scale/era5_clean_test.csv

# Generated by notebooks that support multiple data-source modes (e.g.
# case01's DATA_SOURCE toggle) — resolved at run time, not hand-edited.
notebooks/cases/*_suite_resolved.yaml

*.egg-info/
.venv/
venv/

# Local-only tooling that reaches outside this repo (e.g. into thesis_code,
# a machine-local path not shipped here). Only these scripts' *outputs*
# (small, self-contained reference files) are meant to be committed.
scripts/local/

scripts/compare_to_thesis.py
scripts/generate_mini_era5.py
scripts/slice_real_era5.py
git-cmds.txt
